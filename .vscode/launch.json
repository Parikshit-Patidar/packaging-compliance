{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Streamlit: Packaging Compliance Workbench",
      "type": "debugpy",
      "request": "launch",
      "module": "streamlit",
      "args": [
        "run",
        "${workspaceFolder}/backend/main.py",
        "--server.port=8501",
        "--server.headless=false"
      ],
      "jinja": true,
      "justMyCode": false,
      "console": "integratedTerminal"
    },
    {
      "name": "FastAPI: Compliance REST API",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": [
        "api:app",
        "--app-dir",
        "${workspaceFolder}/backend",
        "--port",
        "8000",
        "--reload"
      ],
      "jinja": true,
      "justMyCode": true,
      "console": "integratedTerminal"
    },
    {
      "name": "FastAPI: WSGI/ASGI Runner",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/wsgi.py",
      "console": "integratedTerminal"
    },
    {
      "name": "Test: Advanced Subsystem Pipeline",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/backend/test_advanced_pipeline.py",
      "console": "integratedTerminal"
    },
    {
      "name": "Test: Forensic Accuracy & BSA Certificate",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/backend/test_accuracy_and_justification.py",
      "console": "integratedTerminal"
    }
  ]
}
