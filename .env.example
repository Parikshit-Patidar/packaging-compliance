# ==============================================================================
# Sovereign Legal Metrology Packaging Compliance Engine — Environment Configuration
# ==============================================================================
# Copy this file to '.env' (or 'backend/.env') and fill in your credentials.
#
# IMPORTANT: Never commit your actual '.env' containing live API keys to GitHub.
# ==============================================================================

# Google Gemini Vision API Key (obtain from https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Vision AI Model Architecture (Default flagship model with automated failover)
# Supported options: gemini-3.8-flash, gemini-3.7-flash, gemini-3.6-flash, gemini-3.5-flash-lite
PREFERRED_MODEL=gemini-3.8-flash

# Server Network Configuration
API_PORT=8000
HOST=127.0.0.1

# Optional Database Path Override (Default: %LOCALAPPDATA%/PackagingCompliance/compliance_vault.db)
# DATABASE_PATH=./compliance_vault.db
